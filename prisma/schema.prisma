datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

model Order {
  id                  String   @id @default(uuid())
  token               String   @unique
  idempotencyKey      String?  @unique
  status              String   @default("new") // new, agreed, completed, cancelled
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Клиент и авто
  clientName          String
  clientPhone         String
  carBrandModel       String
  carClass            String   // S, M, L, OTHER
  isDirty             Boolean  @default(false)

  // Формат обслуживания
  serviceFormat       String   @default("studio") // studio, mobile
  deliveryAddress     String?

  // Время записи
  desiredDate         String?
  desiredTime         String?
  agreedEntryDateTime String?

  // Расчёт стоимости
  knownSubtotal       Float
  mobileFee           Float    @default(0)
  preliminaryTotal    Float
  agreedFinalPrice    Float?
  hasPhotoAppraisal   Boolean  @default(false)

  // Заметки и состав
  clientComment       String?
  privateStudioNote   String?
  itemsJson           String   // JSON-массив CartItem[]
  photosJson          String   @default("[]") // JSON-массив OrderPhoto[]
  tariffsSnapshotJson String   // Слепок тарифов на момент заказа

  // 2D мини-игра
  miniGamePlayed      Boolean  @default(false)
  miniGameBonusCode   String?

  @@index([token])
  @@index([status])
  @@index([createdAt])
}

model StudioConfig {
  id           String   @id @default("default")
  updatedAt    DateTime @updatedAt
  settingsJson String   // JSON со всеми настройками бренда, тарифов, игры и подсказок
}

model AdminAccount {
  id           String   @id @default("admin")
  passwordHash String
  updatedAt    DateTime @updatedAt
}

model AdminSession {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
}

// -----------------------------------------------------------
// МОДУЛЬ ОНЛАЙН-ЗАПИСИ (МУЛЬТИТЕНАНТНОСТЬ)
// -----------------------------------------------------------

model User {
  id             String          @id @default(uuid())
  slug           String          @unique // Публичный URL: /book/[slug] или ?userId=...
  name           String                  // Имя мастера или студии
  email          String          @unique
  phone          String?
  timezone       String          @default("Europe/Moscow")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  services       Service[]
  availabilities Availability[]
  dateOverrides  DateOverride[]
  bookings       Booking[]

  @@index([slug])
}

model Service {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title           String    // Название услуги
  description     String?   // Описание
  durationMinutes Int       // Длительность в минутах (например, 60, 120)
  bufferMinutes   Int       @default(15) // Перерыв после услуги
  price           Float     // Стоимость
  isActive        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bookings        Booking[]

  @@index([userId, isActive])
}

model Availability {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  dayOfWeek    Int      // 0 = Вс, 1 = Пн, ..., 6 = Сб
  startTime    String   // "09:00"
  endTime      String   // "21:00"
  isWorkingDay Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

model DateOverride {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date            String   // "YYYY-MM-DD"
  isDayOff        Boolean  @default(true)
  customStartTime String?  // "10:00"
  customEndTime   String?  // "15:00"

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model Booking {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  clientName  String
  clientPhone String
  clientEmail String?

  startAt     DateTime // UTC timestamp
  endAt       DateTime // UTC timestamp (startAt + duration + buffer)

  status      String   @default("confirmed") // "pending", "confirmed", "cancelled"
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, startAt])
  @@index([userId, status])
  @@index([serviceId])
}
