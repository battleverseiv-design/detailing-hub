datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

// -----------------------------------------------------------
// ПОСТЫ И БОКСЫ ДЕТЕЙЛИНГ-СТУДИИ (WORKBAYS)
// -----------------------------------------------------------

model Workbay {
  id          String    @id @default(uuid())
  name        String    // «Бокс №1 (Мокрый / Экстракция)», «Бокс №2 (Сухой / Полировка)»
  type        String    @default("universal") // wet, dry, cure, universal
  description String?
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings    Booking[]

  @@index([isActive, order])
}

// -----------------------------------------------------------
// ЗАКАЗЫ ДЕТЕЙЛИНГА, ЦИФРОВОЙ АКТ И ФИНАНСЫ (P&L)
// -----------------------------------------------------------

model Order {
  id                  String   @id @default(uuid())
  token               String   @unique
  idempotencyKey      String?  @unique
  status              String   @default("new") // new, agreed, in_progress, ready, completed, cancelled
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Клиент и авто
  clientName          String
  clientPhone         String
  clientEmail         String?
  carBrandModel       String
  carVin              String?  // VIN для автоопределения класса и истории
  carLicensePlate     String?  // Госномер
  carClass            String   // S, M, L, OTHER
  isDirty             Boolean  @default(false)

  // Формат обслуживания
  serviceFormat       String   @default("studio") // studio, mobile
  deliveryAddress     String?

  // Дата и привязка к расписанию боксов
  desiredDate         String?
  desiredTime         String?
  agreedEntryDateTime String?
  
  // Связь с бронированием бокса (1:1)
  bookingId           String?  @unique
  booking             Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  // Расчёт стоимости
  knownSubtotal       Float
  mobileFee           Float    @default(0)
  preliminaryTotal    Float
  agreedFinalPrice    Float?
  hasPhotoAppraisal   Boolean  @default(false)

  // Финансовая аналитика владельца (P&L) и оплата
  suppliesCostRub     Float    @default(0)   // Себестоимость израсходованной автохимии
  masterCommissionPct Float    @default(30)  // Процент мастера от работы (%)
  masterPayoutRub     Float    @default(0)   // Начисленная зарплата мастера
  netProfitRub        Float    @default(0)   // Чистая прибыль студии с заказа
  isPaid              Boolean  @default(false) // Оплачен ли заказ клиентом по факту
  paymentMethod       String   @default("cash") // cash (Наличные), card (Карта/Терминал), sbp (Перевод СБП)

  // Цифровой акт осмотра и приёмки автомобиля
  mileage             Int?     // Пробег авто при сдаче в бокс
  fuelLevel           Int?     // Уровень топлива (0-100%)
  damagesJson         String   @default("[]") // Массив зафиксированных сколов/царапин по зонам кузова
  inspectionPhotosBeforeJson String @default("[]") // Фото «До» с привязкой к зонам
  inspectionPhotosAfterJson  String @default("[]") // Фото «После» (результат детейлинга)
  clientSignatureUrl  String?  // Подпись клиента на приемке
  masterSignatureUrl  String?  // Подпись мастера-приемщика
  actCompletedAt      DateTime?

  // Состав заказа и заметки
  clientComment       String?
  privateStudioNote   String?
  source              String?  // Источник заявки: yandex, vk, 2gis, direct, phone_admin
  itemsJson           String   // JSON-массив CartItem[]
  photosJson          String   @default("[]") // Загруженные клиентом фото при создании заявки
  tariffsSnapshotJson String   // Слепок тарифов на момент оформления

  // Аудит и контроль отмены заказа
  cancelledAt         DateTime? // Время отмены
  cancelledBy         String?   // client | admin | system_no_show
  cancelReason        String?   // Причина отмены или заметка к отмене

  // Назначение мастера и выполнение
  assignedMasterId    String?
  assignedMaster      StaffUser? @relation(fields: [assignedMasterId], references: [id], onDelete: SetNull)
  assignedMasterName  String?    // снимок имени (журнал и список не зависят от переименования)
  workStartedAt       DateTime?

  @@index([token])
  @@index([status])
  @@index([createdAt])
  @@index([carVin])
  @@index([assignedMasterId])
}

// -----------------------------------------------------------
// ОНЛАЙН-ЗАПИСЬ, ГРАФИКИ И СЛОТЫ
// -----------------------------------------------------------

model User {
  id             String          @id @default(uuid())
  slug           String          @unique // Публичный URL: /book/[slug]
  name           String                  // Имя мастера или студии
  email          String          @unique
  phone          String?
  timezone       String          @default("Europe/Moscow")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  services       Service[]
  availabilities Availability[]
  dateOverrides  DateOverride[]
  bookings       Booking[]

  @@index([slug])
}

model Service {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title                 String    // Название услуги
  description           String?
  
  // Фазы выполнения в детейлинге:
  durationMinutes       Int       // Общее время цикла
  activeDurationMinutes Int       @default(60) // Время непосредственной работы мастера
  cureDurationMinutes   Int       @default(0)  // Время кристаллизации/сушки (бокс занят, мастер свободен)
  bufferMinutes         Int       @default(15) // Буфер на приемку/выдачу и проветривание
  
  price                 Float     // Базовая стоимость (Класс S)
  requiredBayType       String    @default("any") // wet, dry, cure, any
  
  // Технологические зависимости (например, Керамика требует предварительной полировки)
  requiredServiceIdsJson String   @default("[]") // Массив id обязательных услуг
  
  // Матрица цен и длительности по классам авто
  classMultipliersJson  String    @default("{\"S\":1.0,\"M\":1.25,\"L\":1.5}")
  
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  bookings              Booking[]

  @@index([userId, isActive])
}

model Availability {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  dayOfWeek    Int      // 0 = Вс, 1 = Пн, ..., 6 = Сб
  startTime    String   // "09:00"
  endTime      String   // "21:00"
  isWorkingDay Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

model DateOverride {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date            String   // "YYYY-MM-DD"
  isDayOff        Boolean  @default(true)
  customStartTime String?  // "10:00"
  customEndTime   String?  // "15:00"

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model Booking {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  serviceId           String
  service             Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  // Привязка к физическому боксу студии
  workbayId           String?
  workbay             Workbay?  @relation(fields: [workbayId], references: [id], onDelete: SetNull)

  // Связь с заказом детейлинга
  order               Order?

  clientName          String
  clientPhone         String
  clientEmail         String?

  // Полный временной интервал бронирования
  startAt             DateTime  // Начало работ
  endAt               DateTime  // Окончание всех фаз (включая сушку и буфер)

  // Фазовое расписание
  activeWorkEndAt     DateTime? // Окончание работы мастера (мастер освобождается для другого авто)
  cureEndAt           DateTime? // Окончание сушки (освобождается бокс)
  isMultiDay          Boolean   @default(false) // Переходит ли на следующий рабочий день

  status              String    @default("confirmed") // pending, confirmed, in_progress, completed, cancelled
  notes               String?
  
  // Внешняя синхронизация
  googleCalendarEventId String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, startAt])
  @@index([userId, status])
  @@index([workbayId, startAt, endAt])
  @@index([serviceId])
}

// -----------------------------------------------------------
// НАСТРОЙКИ СТУДИИ И БЕЗОПАСНОСТЬ
// -----------------------------------------------------------

model StudioConfig {
  id           String   @id @default("default")
  updatedAt    DateTime @updatedAt
  settingsJson String   // JSON настроек бренда, контактов, тарифов, Telegram и множителей
}

model AdminAccount {
  id           String   @id @default("admin")
  passwordHash String
  updatedAt    DateTime @updatedAt
}

model AdminSession {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
}

// -----------------------------------------------------------
// СОТРУДНИКИ (RBAC), СЕССИИ, RATE LIMIT И ЖУРНАЛ ДЕЙСТВИЙ
// -----------------------------------------------------------

model StaffUser {
  id             String         @id @default(uuid())
  login          String         @unique            // строчными буквами
  name           String
  phone          String?
  role           String         @default("master") // admin | master
  passwordHash   String                            // пароль админа / PIN мастера
  credVersion    Int            @default(2)        // 1 = старый bcrypt без pepper, 2 = текущий
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sessions       StaffSession[]
  assignedOrders Order[]
}

model StaffSession {
  id        String    @id @default(uuid())
  tokenHash String    @unique                      // SHA-256 от токена из cookie
  staffId   String
  staff     StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime

  @@index([staffId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  key       String                                  // "login:<логин>" или "ip:<адрес>"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Журнал действий. БЕЗ внешнего ключа на Order: записи переживают удаление заказа.
model OrderAuditLog {
  id        String   @id @default(uuid())
  orderId   String
  actorId   String?                                 // StaffUser.id; null для клиента и системы
  actorName String                                  // снимок имени на момент события
  actorRole String                                  // admin | master | client | system
  action    String                                  // order.created, order.claimed, ...
  message   String
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}
